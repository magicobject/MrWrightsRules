{
  "name": "mrwrightsrules",
  "version": "1.0.0",
  "description": "Mr Wright's Rules static site — feature tests for nav, page content and 404 handling.",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mjs",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"test-unit/**/*.test.mjs\"",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "serve": "tsx test/support/static-server.ts",
    "typecheck": "tsc",
    "audit": "npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicobject/MrWrightsRules.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magicobject/MrWrightsRules/issues"
  },
  "homepage": "https://github.com/magicobject/MrWrightsRules#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
